NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
GROQ_API_KEY=
GEMINI_API_KEY=
# Comma-separated exact frontend origins. Add your Vercel URL here if it differs from the built-in production URL.
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Production object storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional local development storage path
FILE_STORAGE_DIR=
